source_url = "https://github.com/frcsoftware/frcsoftware.org.git"

stage1a_dest_rev_solution   = "https://github.com/frcsoftware/stage1a-solution-rev.git"
stage1a_dest_ctre_solution  = "https://github.com/frcsoftware/stage1a-solution-ctre.git"

stage1b_dest_ctre_solution = "https://github.com/frcsoftware/stage1b-solution-ctre.git"

stage1_dest_rev_template = "https://github.com/frcsoftware/stage1-template-rev.git"
stage1_dest_ctre_template = "https://github.com/frcsoftware/stage1-template-ctre.git"

def create_workflow(name, source_path, dest_url):
    core.workflow(
        name = name,
        origin = git.github_origin(
            url = source_url,
            ref = "main",
        ),
        destination = git.github_destination(
            url = dest_url,
            fetch = "main",
            push = "main",
        ),
        origin_files = glob([source_path + "/**", "examples/LICENSE"]),
        authoring = authoring.pass_thru("Automated Sync <noreply@frcsoftware.org>"),
        transformations = [
            core.move(source_path, ""),
            core.move("examples/LICENSE", "LICENSE"),

            # Remove website embedding code region markers (e.g., // [region] or // [/region])
            core.replace(
                before = "${marker}",
                after = "",
                multiline = True,
                regex_groups = {
                    "marker": "^[ \\t]*//[ \\t]*\\[/?.*?\\][ \\t]*\\n?"
                }
            ),
        ],
    )

create_workflow(
    name = "stage1a_ctre_solution",
    source_path = "examples/stage1/stage1a/solutions/ctre",
    dest_url = stage1a_dest_ctre_solution
)

create_workflow(
    name = "stage1a_rev_solution",
    source_path = "examples/stage1/stage1a/solutions/rev",
    dest_url = stage1a_dest_rev_solution
)

create_workflow(
    name = "stage1b_ctre_solution",
    source_path = "examples/stage1/stage1b/solutions/ctre",
    dest_url = stage1b_dest_ctre_solution
)


create_workflow(
    name = "stage1_ctre_template",
    source_path = "examples/stage1/templates/ctre",
    dest_url = stage1_dest_ctre_template
)

create_workflow(
    name = "stage1_rev_template",
    source_path = "examples/stage1/templates/rev",
    dest_url = stage1_dest_rev_template
)
