---
/**
 * Renders every entry in the `glossary` content collection, alphabetically.
 *
 * Usage:
 * <GlossaryList />
 */

import { getCollection } from 'astro:content';
import { defaultLang } from '../config/locales';

interface Props {
    lang?: string;
}

const { lang = defaultLang } = Astro.props;

const terms = (await getCollection('glossary'))
    .filter(({ data }) => data.lang === lang)
    .sort((a, b) =>
        a.data.term.toLowerCase().localeCompare(b.data.term.toLowerCase()),
    );
---

<dl class="glossary-list">
    {
        terms.map(({ data }) => (
            <div class="glossary-entry">
                <dt id={data.term.toLowerCase().replace(/\s+/g, '-')}>
                    {data.term}
                </dt>
                <dd>{data.definition}</dd>
            </div>
        ))
    }
</dl>

<style>
    .glossary-list {
        margin: 0;
    }

    .glossary-entry + .glossary-entry {
        margin-top: 1.5rem;
    }

    dt {
        font-weight: 600;
        color: var(--sl-color-white);
    }

    dd {
        margin: 0.25rem 0 0;
    }
</style>
